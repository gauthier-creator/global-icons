# Site cible dans Google Search Console
# Format 1 (Domaine — recommandé) : sc-domain:globalicons.io
# Format 2 (URL préfixe)          : https://www.globalicons.io/
GSC_SITE_URL=sc-domain:globalicons.io

# Contenu JSON complet du service account Google Cloud (single ligne, JSON parsable)
# Créé dans Google Cloud Console > IAM > Service Accounts > Clés > Ajouter JSON
# À coller ENTIÈREMENT ici en une ligne (Railway acceptera aussi le multi-ligne)
GSC_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"tracker@xxx.iam.gserviceaccount.com",...}

# Basic auth (obligatoire en prod, laisser vide en local pour désactiver)
AUTH_USER=admin
AUTH_PASS=changeme

# Port Express (Railway le fournit automatiquement)
PORT=3000
