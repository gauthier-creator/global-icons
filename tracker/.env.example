# Clé API Serper.dev (source des positions Google live)
# Compte gratuit sur https://serper.dev (2500 requêtes offertes), puis Dashboard > API Key
SERPER_API_KEY=votre_cle_serper

# Répertoire de stockage de l'historique des scans.
# En prod Railway : pointer vers un VOLUME persistant (ex: /data), sinon l'historique
# est perdu à chaque redéploiement.
DATA_DIR=./data

# Basic auth (obligatoire en prod, laisser AUTH_PASS vide en local pour désactiver)
AUTH_USER=admin
AUTH_PASS=changeme

# Port Express (Railway le fournit automatiquement)
PORT=3000

# --- Onglet SEA : Google Ads API (lecture seule) ---
# Valeurs depuis le google-ads.yaml. login_customer_id / customer_id = 1913432498.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1913432498
# GOOGLE_ADS_API_VERSION=   # optionnel, sinon resolution auto (v22->v17)

# --- Meta CAPI (STAGING - a remplir quand le Pixel/Dataset existera) ---
# Tant que META_DATASET_ID / META_CAPI_TOKEN sont vides, aucun evenement ne part vers Meta.
META_DATASET_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=          # defini => events vers l'outil Test Events (valider EMQ avant prod), vider pour passer live
# META_API_VERSION=v21.0       # optionnel
CALENDLY_WEBHOOK_SIGNING_KEY=  # signing key de l'abonnement webhook Calendly (verif signature)
